<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Kvittomall Beta 1.2</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:15px;
    font-family:Arial, sans-serif;
    background:#f2f2f2;
    color:#111827;
}

.wrapper{
    max-width:800px;
    margin:auto;
    background:#ffffff;
    padding:20px;
    border-radius:12px;
    box-shadow:0 2px 12px rgba(0,0,0,0.10);
}

h1{
    text-align:center;
    margin:0 0 4px 0;
}

.version{
    text-align:center;
    color:#555;
    margin-bottom:22px;
}

section{
    margin-top:22px;
    padding-top:16px;
    border-top:2px solid #e5e7eb;
}

details{
    margin-top:22px;
    border:1px solid #cfcfcf;
    border-radius:10px;
    padding:12px;
    background:#fafafa;
}

summary{
    font-weight:bold;
    font-size:18px;
    cursor:pointer;
}

label{
    display:block;
    margin-top:10px;
    margin-bottom:5px;
    font-weight:bold;
}

input,
select,
textarea,
button{
    width:100%;
    padding:12px;
    min-height:46px;
    font-size:16px;
    border-radius:8px;
    border:1px solid #9ca3af;
    font-family:inherit;
}

textarea{
    min-height:90px;
    resize:vertical;
}

input:focus,
select:focus,
textarea:focus,
button:focus{
    outline:3px solid #2563eb;
    outline-offset:2px;
}

button{
    margin-top:10px;
    border:none;
    cursor:pointer;
    font-weight:bold;
}

.btn-primary{
    background:#2563eb;
    color:#ffffff;
}

.btn-secondary{
    background:#e5e7eb;
    color:#111827;
}

.btn-danger{
    background:#dc2626;
    color:#ffffff;
}

.btn-print{
    background:#16a34a;
    color:#ffffff;
}

.product-card{
    border:1px solid #d1d5db;
    border-radius:12px;
    padding:14px;
    margin-top:14px;
    background:#f9fafb;
}

.row-total{
    margin-top:12px;
    padding:12px;
    background:#ffffff;
    border-radius:8px;
    font-size:18px;
    font-weight:bold;
}

.total-box,
.preview-box{
    background:#f9fafb;
    border:1px solid #d1d5db;
    border-radius:10px;
    padding:14px;
}

.total-row{
    display:flex;
    justify-content:space-between;
    gap:10px;
    margin-bottom:10px;
}

.grand-total{
    font-size:22px;
    font-weight:bold;
    border-top:2px solid #d1d5db;
    padding-top:12px;
    margin-top:12px;
}

.preview-box{
    white-space:pre-wrap;
    line-height:1.5;
}

.saved-note{
    min-height:22px;
    color:#166534;
    font-weight:bold;
    margin-top:8px;
}

.help{
    color:#555;
    font-size:14px;
    margin-top:5px;
}

@media print{
    body{
        background:#ffffff;
        padding:0;
    }

    .wrapper{
        box-shadow:none;
        border-radius:0;
        padding:12mm;
    }

    .no-print,
    details{
        display:none !important;
    }
}
</style>
</head>

<body>

<main class="wrapper">

<h1>Kvittomall</h1>
<p class="version">Beta 1.2</p>

<section aria-labelledby="receipt-info-heading">
    <h2 id="receipt-info-heading">Kvittoinformation</h2>

    <p><strong>Datum:</strong> <span id="receiptDate"></span></p>
    <p><strong>Kvittonummer:</strong> <span id="receiptNumber"></span></p>

    <div id="sellerPreview" class="preview-box"></div>

    <label for="paymentMethod">Betalningssätt</label>
    <select id="paymentMethod" onchange="toggleOtherPayment()">
        <option>Swish</option>
        <option>Kontant</option>
        <option>Kort</option>
        <option>Annat</option>
    </select>

    <div id="otherPaymentWrap" style="display:none;">
        <label for="otherPayment">Ange betalningssätt</label>
        <input id="otherPayment" type="text">
    </div>

    <label for="vatRate">Momssats</label>
    <select id="vatRate" onchange="updateTotals()">
        <option value="0">Ingen moms</option>
        <option value="6">6 %</option>
        <option value="12">12 %</option>
        <option value="25">25 %</option>
    </select>
</section>

<section aria-labelledby="products-heading">
    <h2 id="products-heading">Produkter</h2>

    <div id="products"></div>

    <button class="btn-primary no-print" type="button" onclick="addProduct()">Lägg till produkt</button>
</section>

<section aria-labelledby="summary-heading">
    <h2 id="summary-heading">Summering</h2>

    <div class="total-box" aria-live="polite">
        <div class="total-row">
            <span>Summa exkl moms</span>
            <span><span id="subtotal">0.00</span> kr</span>
        </div>

        <div class="total-row">
            <span>Moms</span>
            <span><span id="vatAmount">0.00</span> kr</span>
        </div>

        <div class="total-row grand-total">
            <span>Att betala</span>
            <span><span id="grandTotal">0.00</span> kr</span>
        </div>
    </div>
</section>

<section aria-labelledby="footer-heading">
    <h2 id="footer-heading">Aktuell kvittotext</h2>
    <div id="footerPreview" class="preview-box"></div>
</section>

<section class="no-print" aria-labelledby="actions-heading">
    <h2 id="actions-heading">Knappar</h2>

    <button class="btn-secondary" type="button" onclick="newReceipt()">Nytt kvitto</button>
    <button class="btn-print" type="button" onclick="window.print()">Skriv ut kvitto</button>
</section>

<details class="no-print">
    <summary>⚙ Inställningar</summary>

    <h2>Företagsuppgifter</h2>

    <label for="companyName">Företagsnamn</label>
    <input id="companyName" type="text">

    <label for="orgNumber">Organisationsnummer</label>
    <input id="orgNumber" type="text">

    <label for="companyAddress">Adress</label>
    <input id="companyAddress" type="text">

    <label for="companyPhone">Telefon</label>
    <input id="companyPhone" type="tel">

    <h2>Kvittoinställningar</h2>

    <label for="eventName">Marknadsplats / Event</label>
    <input id="eventName" type="text" placeholder="Exempel: Sunne Marknad 2026">

    <label for="receiptMessage">Hälsning</label>
    <textarea id="receiptMessage" placeholder="Tack för ditt köp!&#10;Välkommen åter."></textarea>

    <label for="swishNumber">Swishnummer</label>
    <input id="swishNumber" type="text" inputmode="numeric">

    <label for="website">Webbplats</label>
    <input id="website" type="text">

    <label for="facebook">Facebook</label>
    <input id="facebook" type="text">

    <button class="btn-primary" type="button" onclick="saveSettings()">Spara inställningar</button>
    <button class="btn-secondary" type="button" onclick="clearSettings()">Rensa inställningar</button>

    <div id="settingsNote" class="saved-note" aria-live="polite"></div>
</details>

</main>

<script>
const settingsKey = "kvittomall_beta_1_2_settings";
const counterKey = "kvittomall_beta_1_2_counter";

function setDate(){
    const today = new Date();
    document.getElementById("receiptDate").textContent = today.toLocaleDateString("sv-SE");
}

function setReceiptNumber(){
    const currentNumber = Number(localStorage.getItem(counterKey) || "1");
    document.getElementById("receiptNumber").textContent = "KV-" + String(currentNumber).padStart(6, "0");
}

function saveSettings(){
    const settings = {
        companyName: document.getElementById("companyName").value,
        orgNumber: document.getElementById("orgNumber").value,
        companyAddress: document.getElementById("companyAddress").value,
        companyPhone: document.getElementById("companyPhone").value,
        eventName: document.getElementById("eventName").value,
        receiptMessage: document.getElementById("receiptMessage").value,
        swishNumber: document.getElementById("swishNumber").value,
        website: document.getElementById("website").value,
        facebook: document.getElementById("facebook").value
    };

    localStorage.setItem(settingsKey, JSON.stringify(settings));

    document.getElementById("settingsNote").textContent = "Inställningarna är sparade på den här enheten.";

    updatePreviews();
}

function clearSettings(){
    localStorage.removeItem(settingsKey);

    document.getElementById("companyName").value = "";
    document.getElementById("orgNumber").value = "";
    document.getElementById("companyAddress").value = "";
    document.getElementById("companyPhone").value = "";
    document.getElementById("eventName").value = "";
    document.getElementById("receiptMessage").value = "";
    document.getElementById("swishNumber").value = "";
    document.getElementById("website").value = "";
    document.getElementById("facebook").value = "";

    document.getElementById("settingsNote").textContent = "Inställningarna är rensade.";

    updatePreviews();
}

function loadSettings(){
    const settings = JSON.parse(localStorage.getItem(settingsKey) || "null");

    if(!settings){
        document.getElementById("receiptMessage").value = "Tack för ditt köp!\\nVälkommen åter.";
        updatePreviews();
        return;
    }

    document.getElementById("companyName").value = settings.companyName || "";
    document.getElementById("orgNumber").value = settings.orgNumber || "";
    document.getElementById("companyAddress").value = settings.companyAddress || "";
    document.getElementById("companyPhone").value = settings.companyPhone || "";
    document.getElementById("eventName").value = settings.eventName || "";
    document.getElementById("receiptMessage").value = settings.receiptMessage || "";
    document.getElementById("swishNumber").value = settings.swishNumber || "";
    document.getElementById("website").value = settings.website || "";
    document.getElementById("facebook").value = settings.facebook || "";

    updatePreviews();
}

function updatePreviews(){
    const companyName = document.getElementById("companyName").value.trim();
    const orgNumber = document.getElementById("orgNumber").value.trim();
    const companyAddress = document.getElementById("companyAddress").value.trim();
    const companyPhone = document.getElementById("companyPhone").value.trim();
    const eventName = document.getElementById("eventName").value.trim();
    const receiptMessage = document.getElementById("receiptMessage").value.trim();
    const swishNumber = document.getElementById("swishNumber").value.trim();
    const website = document.getElementById("website").value.trim();
    const facebook = document.getElementById("facebook").value.trim();

    let sellerText = "Säljare\\n";

    if(companyName){
        sellerText += companyName + "\\n";
    }

    if(orgNumber){
        sellerText += "Org.nr: " + orgNumber + "\\n";
    }

    if(companyAddress){
        sellerText += companyAddress + "\\n";
    }

    if(companyPhone){
        sellerText += "Telefon: " + companyPhone + "\\n";
    }

    if(eventName){
        sellerText += "\\nMarknadsplats / Event\\n" + eventName;
    }

    if(sellerText === "Säljare\\n"){
        sellerText = "Inga sparade säljaruppgifter ännu. Öppna inställningar längst ner för att fylla i dem.";
    }

    document.getElementById("sellerPreview").textContent = sellerText;

    let footerText = "";

    if(receiptMessage){
        footerText += receiptMessage;
    }

    if(swishNumber){
        footerText += (footerText ? "\\n\\n" : "") + "Swish: " + swishNumber;
    }

    if(website){
        footerText += (footerText ? "\\n" : "") + website;
    }

    if(facebook){
        footerText += (footerText ? "\\n" : "") + facebook;
    }

    document.getElementById("footerPreview").textContent = footerText || "Ingen kvittotext är angiven.";
}

function toggleOtherPayment(){
    const paymentMethod = document.getElementById("paymentMethod").value;
    const otherPaymentWrap = document.getElementById("otherPaymentWrap");

    otherPaymentWrap.style.display = paymentMethod === "Annat" ? "block" : "none";
}

function addProduct(){
    const productNumber = document.querySelectorAll(".product-card").length + 1;
    const productCard = document.createElement("div");

    productCard.className = "product-card";

    productCard.innerHTML = `
        <h3>Produkt ${productNumber}</h3>

        <label>Produktnamn</label>
        <input class="product-name" type="text" placeholder="Exempel: Honung">

        <label>Antal</label>
        <input class="quantity" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Antal">

        <label>Enhet</label>
        <select class="unit" onchange="toggleOtherUnit(this)">
            <option>st</option>
            <option>kg</option>
            <option>hg</option>
            <option>g</option>
            <option>liter</option>
            <option>dl</option>
            <option>cl</option>
            <option>meter</option>
            <option>påse</option>
            <option>flaska</option>
            <option>burk</option>
            <option>kartong</option>
            <option>låda</option>
            <option>bukett</option>
            <option>Annan...</option>
        </select>

        <div class="other-unit-wrap" style="display:none;">
            <label>Annan enhet</label>
            <input class="other-unit" type="text" placeholder="Exempel: säck">
        </div>

        <label>Pris per enhet</label>
        <input class="price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00">
        <div class="help">Skriv priset utan kr, till exempel 13 eller 13.50.</div>

        <div class="row-total">Radsumma: <span class="row-total-value">0.00</span> kr</div>

        <button class="btn-danger no-print" type="button" onclick="removeProduct(this)">Ta bort produkt</button>
    `;

    document.getElementById("products").appendChild(productCard);

    productCard.querySelectorAll("input, select").forEach(function(field){
        field.addEventListener("input", updateTotals);
        field.addEventListener("change", updateTotals);
    });

    updateTotals();
}

function toggleOtherUnit(selectElement){
    const wrapper = selectElement.closest(".product-card").querySelector(".other-unit-wrap");
    wrapper.style.display = selectElement.value === "Annan..." ? "block" : "none";
}

function removeProduct(button){
    button.closest(".product-card").remove();
    renumberProducts();
    updateTotals();
}

function renumberProducts(){
    document.querySelectorAll(".product-card h3").forEach(function(heading, index){
        heading.textContent = "Produkt " + (index + 1);
    });
}

function updateTotals(){
    let subtotal = 0;

    document.querySelectorAll(".product-card").forEach(function(card){
        const quantityField = card.querySelector(".quantity");
        const priceField = card.querySelector(".price");

        const quantity = quantityField.value === "" ? 0 : Number(quantityField.value);
        const price = priceField.value === "" ? 0 : Number(priceField.value);

        const rowTotal = quantity * price;

        card.querySelector(".row-total-value").textContent = rowTotal.toFixed(2);

        subtotal += rowTotal;
    });

    const vatRate = Number(document.getElementById("vatRate").value || "0");
    const vatAmount = subtotal * vatRate / 100;
    const grandTotal = subtotal + vatAmount;

    document.getElementById("subtotal").textContent = subtotal.toFixed(2);
    document.getElementById("vatAmount").textContent = vatAmount.toFixed(2);
    document.getElementById("grandTotal").textContent = grandTotal.toFixed(2);
}

function newReceipt(){
    const shouldCreate = confirm("Vill du skapa ett nytt kvitto? Sparade inställningar finns kvar.");

    if(!shouldCreate){
        return;
    }

    const currentNumber = Number(localStorage.getItem(counterKey) || "1");
    localStorage.setItem(counterKey, String(currentNumber + 1));

    document.getElementById("products").innerHTML = "";
    document.getElementById("paymentMethod").value = "Swish";
    document.getElementById("otherPayment").value = "";
    document.getElementById("vatRate").value = "0";

    setDate();
    setReceiptNumber();
    toggleOtherPayment();
    addProduct();
    updateTotals();
}

document.getElementById("companyName").addEventListener("input", updatePreviews);
document.getElementById("orgNumber").addEventListener("input", updatePreviews);
document.getElementById("companyAddress").addEventListener("input", updatePreviews);
document.getElementById("companyPhone").addEventListener("input", updatePreviews);
document.getElementById("eventName").addEventListener("input", updatePreviews);
document.getElementById("receiptMessage").addEventListener("input", updatePreviews);
document.getElementById("swishNumber").addEventListener("input", updatePreviews);
document.getElementById("website").addEventListener("input", updatePreviews);
document.getElementById("facebook").addEventListener("input", updatePreviews);

setDate();
setReceiptNumber();
loadSettings();
toggleOtherPayment();
addProduct();
updateTotals();
</script>

</body>
</html>
